{
	"tasks": [
		{
			"type": "cppbuild",
			"label": "Build",
			"command": "cl.exe",
			"args": [
					"/Z7",
					"/EHsc",
					"/nologo",
					"/MD",
					"/I", "${workspaceFolder}/TheBrokenChristmas/Game/Packages/Openssl/include",
					"/I", "${workspaceFolder}/TheBrokenChristmas/Game/Packages",
					"/d1trimfile:${workspaceFolder}\\",
					"main.cpp",
					"/Fe${workspaceFolder}/TheBrokenChristmas/Game/TheBrokenChristmas.exe",
					"/link",
					"/LIBPATH:${workspaceFolder}/TheBrokenChristmas/Game/Packages/Openssl",
					"/LIBPATH:${workspaceFolder}/TheBrokenChristmas/Game/Packages/SDL2/lib",
					"/DEBUG",
					"/PDB:${workspaceFolder}/TheBrokenChristmas/Game/TheBrokenChristmas.pdb",
					"/PDBALTPATH:%_PDB%",
					"/Brepro",
					"shell32.lib",
					"opengl32.lib",
					"SDL2.lib",
					"SDL2main.lib",
					"SDL2_ttf.lib",
					"SDL2_image.lib",
					"libssl.lib",
					"libcrypto.lib",
					"ws2_32.lib",
					"/MACHINE:X64",
					"/Subsystem:Windows"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$msCompile"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		}
	],
	"version": "2.0.0"
}