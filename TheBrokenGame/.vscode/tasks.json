{
	"tasks": [
		{
			"type": "cppbuild",
			"label": "Build",
			"command": "cl.exe",
			"args": [
				"/Z7",
				"/EHsc",
				"/nologo",
				"main.cpp",
				"/Fe${workspaceFolder}/build/program.exe",
				"/link",
				"shell32.lib",
				"opengl32.lib",
				"SDL2/lib/SDL2.lib",
				"SDL2/lib/SDL2main.lib",
				"SDL2/lib/SDL2_ttf.lib",
				"SDL2/lib/SDL2_image.lib",
				"/MACHINE:X64",
				"/Subsystem:Windows"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$msCompile"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		}
	],
	"version": "2.0.0"
}